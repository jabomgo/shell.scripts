#!/usr/bin/env bash
# to-hevc — converte vídeos de um diretório para HEVC/H.265
# Uso: to-hevc [--cpu] [--amd] [--recursive] [--preset=<preset>] [--cq=<valor>] <origem> [destino]

set -uo pipefail

# --- Cores ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

USE_CPU=false
USE_AMD=false
RECURSIVE=false
PRESET=""
CQ=25
POSITIONAL=()

for arg in "$@"; do
	case "$arg" in
	--cpu) USE_CPU=true ;;
	--amd) USE_AMD=true ;;
	--recursive) RECURSIVE=true ;;
	--preset=*) PRESET="${arg#*=}" ;;
	--cq=*) CQ="${arg#*=}" ;;
	*) POSITIONAL+=("$arg") ;;
	esac
done

SRC="${POSITIONAL[0]:-}"
DST="${POSITIONAL[1]:-}"

# --- Validação ---
if [[ -z "$SRC" ]]; then
	echo -e "${BOLD}Uso:${RESET} $(basename "$0") [--cpu] [--amd] [--recursive] [--preset=<preset>] [--cq=<valor>] <diretorio_origem> [diretorio_destino]"
	echo
	echo -e "${BOLD}Encoders:${RESET}"
	echo -e "  (padrão)   GPU Nvidia  hevc_nvenc   presets: p1..p7, slow, medium, fast"
	echo -e "  --amd      GPU AMD     hevc_amf     presets: quality, balanced, speed"
	echo -e "  --cpu      CPU         libx265      presets: ultrafast..veryslow  (usa CRF)"
	echo
	echo -e "${BOLD}Qualidade:${RESET}"
	echo -e "  --cq=<N>   CQ/CRF: menor = mais qualidade (padrão: ${CQ})"
	echo -e "             18-22: quase sem perda | 24-28: boa qualidade | 30+: menor arquivo"
	exit 1
fi

if [[ "$USE_CPU" == true && "$USE_AMD" == true ]]; then
	echo -e "${RED}[ERRO]${RESET} Use apenas --cpu ou --amd, não os dois."
	exit 1
fi

if [[ ! -d "$SRC" ]]; then
	echo -e "${RED}[ERRO]${RESET} '$SRC' não é um diretório válido."
	exit 1
fi

if [[ -z "$DST" ]]; then
  DST="$SRC/hevc"
fi

mkdir -p "$DST"

# --- Encoder ---
echo "---"
if [[ "$USE_CPU" == true ]]; then
	[[ -z "$PRESET" ]] && PRESET="slow"
	ENCODER_ARGS=(-c:v libx265 -crf "$CQ" -preset "$PRESET")
	echo -e "${CYAN}[MODO]${RESET} CPU — libx265 — preset: ${BOLD}$PRESET${RESET}"
elif [[ "$USE_AMD" == true ]]; then
	[[ -z "$PRESET" ]] && PRESET="quality"
	ENCODER_ARGS=(-c:v hevc_amf -quality "$PRESET" -rc cqp -qp_i "$CQ" -qp_p "$((CQ + 2))")
	echo -e "${CYAN}[MODO]${RESET} GPU AMD — hevc_amf — preset: ${BOLD}$PRESET${RESET}"
else
	[[ -z "$PRESET" ]] && PRESET="slow"
	ENCODER_ARGS=(-c:v hevc_nvenc -preset "$PRESET" -rc vbr -cq "$CQ")
	echo -e "${CYAN}[MODO]${RESET} GPU Nvidia — hevc_nvenc — preset: ${BOLD}$PRESET${RESET}"
fi

# --- Coleta de arquivos ---
shopt -s nullglob
if [[ "$RECURSIVE" == true ]]; then
	mapfile -t FILES < <(find "$SRC" -type f \( \
		-iname "*.mp4" -o -iname "*.mkv" -o -iname "*.avi" \
		-o -iname "*.mov" -o -iname "*.webm" -o -iname "*.flv" \
		\))
else
	FILES=("$SRC"/*.{mp4,mkv,avi,mov,webm,flv})
fi

if [[ ${#FILES[@]} -eq 0 ]]; then
	echo -e "${YELLOW}[AVISO]${RESET} Nenhum vídeo encontrado em '$SRC'."
	exit 0
fi

echo -e "${BOLD}Origem :${RESET} $SRC"
echo -e "${BOLD}Destino:${RESET} $DST"
echo -e "${BOLD}CQ/CRF :${RESET} $CQ"
echo -e "${BOLD}Total  :${RESET} ${#FILES[@]} arquivo(s)"
echo "---"

total=${#FILES[@]}
count=0
done_count=0

for f in "${FILES[@]}"; do
	((count++))
	name="$(basename "${f%.*}")"
	out="$DST/${name}.mkv"

	if [[ -f "$out" ]]; then
		echo -e "${YELLOW}[SKIP]${RESET}  [$count/$total] $name.mkv já existe."
		continue
	fi

	codec=$(ffprobe -v error -select_streams v:0 \
		-show_entries stream=codec_name \
		-of default=nw=1:nk=1 "$f")
	if [[ "$codec" == "hevc" ]]; then
		echo -e "${YELLOW}[SKIP]${RESET}  [$count/$total] $(basename "$f") já é HEVC."
		continue
	fi

	orig_size=$(du -sh "$f" | cut -f1)
	echo -e "${BLUE}[>>>]${RESET}  [$count/$total] $(basename "$f")  (${orig_size})"

	printf "\n"
	new_size=$(du -sh "$out" | cut -f1)
	((done_count++))
	echo -e "${GREEN}[OK]${RESET} $name.mkv (${orig_size} → ${new_size})"
done

echo "---"
echo -e "${GREEN}${BOLD}Concluído.${RESET} $done_count convertido(s). Arquivos em: $DST"
